{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "generate:infusion-asp": "tsx scripts/generate-infusion-asp-data.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "tsc --noEmit --pretty false",
    "test": "tsx --test test/landing-premium-contract.test.ts test/pgx-phase2.test.ts test/pgx-cms-importer.test.ts test/burn-coding.test.ts test/burn-body-map.test.tsx test/burn-document-understanding.test.ts test/burn-workspace-render.test.tsx test/ambulance-coding.test.ts test/ambulance-nemsis.test.ts test/ambulance-workspace-render.test.tsx test/transplant-coding.test.ts test/transplant-workspace-render.test.tsx test/otp-mat-coding.test.ts test/otp-mat-workspace-render.test.tsx test/em-mdm-coding.test.ts test/em-mdm-workspace-render.test.tsx test/hcc-coding.test.ts test/hcc-workspace-render.test.tsx test/infusion-coding.test.ts test/infusion-document-understanding.test.ts test/infusion-workspace-render.test.tsx test/nicu-coding.test.ts test/nicu-document-understanding.test.ts test/nicu-workspace-render.test.tsx test/vad-ecmo-coding.test.ts test/vad-ecmo-document-understanding.test.ts test/vad-ecmo-workspace-render.test.tsx test/cabg-coding.test.ts test/cabg-document-understanding.test.ts test/cabg-workspace-render.test.tsx test/cath-pci-coding.test.ts test/cath-pci-document-understanding.test.ts test/cath-pci-workspace-render.test.tsx",
