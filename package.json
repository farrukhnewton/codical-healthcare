    "test:e2e": "tsx --test test/pgx-api-contract.test.ts",
    "test:a11y": "tsx --test test/pgx-accessibility.test.ts",
    "test:migrations": "tsx scripts/test-pgx-migrations.ts",
    "smoke:prod": "tsx scripts/smoke-production.ts",
    "db:push": "drizzle-kit push",
    "sync:payer-policies": "tsx scripts/sync-payer-policies.ts",
    "cf:whoami": "wrangler whoami",
    "cf:verify": "tsx scripts/verify-cloudflare.ts",
    "cf:d1:info": "wrangler d1 info codical_mcd",
    "cf:d1:migrate": "wrangler d1 migrations apply codical_mcd --remote",
    "cf:d1:tables": "wrangler d1 execute codical_mcd --remote --command \"SELECT name, type FROM sqlite_schema WHERE type IN ('table','view') ORDER BY type, name\"",
    "cf:r2:list": "wrangler r2 bucket list",
    "cf:ncci:deploy": "wrangler deploy --config cloudflare/workers/wrangler.ncci.toml",
    "cf:mcd:deploy": "wrangler deploy --config cloudflare/workers/wrangler.mcd.toml",
    "r2:upload-mcd:dry": "tsx scripts/upload-mcd-raw-to-r2.ts",
    "r2:upload-mcd": "tsx scripts/upload-mcd-raw-to-r2.ts --execute",
    "r2:export-ncci:dry": "tsx scripts/export-ncci-to-r2-shards.ts --build-only",
    "r2:export-ncci": "tsx scripts/export-ncci-to-r2-shards.ts --execute",
    "cf:import-mcd-current:dry": "tsx scripts/import-mcd-current-to-cloudflare.ts",
    "cf:import-mcd-current": "tsx scripts/import-mcd-current-to-cloudflare.ts --execute",
    "pgx:import-cms:dry": "tsx scripts/import-pgx-cms.ts",
    "pgx:import-cms": "tsx scripts/import-pgx-cms.ts --execute"
  },
