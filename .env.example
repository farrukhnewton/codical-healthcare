VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://...
GEMINI_API_KEY=your_gemini_key
NODE_ENV=production

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_NAME=codical_mcd
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET_MCD_RAW=codical-mcd-raw
R2_BUCKET_USER_FILES=codical-user-files
# PGx private storage. Leave unset until the bucket, environment, tenant,
# retention, and security gates are explicitly approved.
R2_BUCKET_PGX=
PGX_STORAGE_ENV=
PGX_DEFAULT_TENANT_ID=
PGX_R2_RETENTION_DAYS=
PGX_PHI_MODE=disabled
PGX_EXTRACTION_PROVIDER=native_pdf_manual
PGX_TARGET_MAC=ALL_SOURCE_MACS
PGX_TARGET_STATES=ALL_US_SERVICE_AREAS
PGX_CPT_LICENSE_REFERENCE=
# The CMS importer intentionally requires its own explicit connection string
# so a generic production DATABASE_URL is never selected by accident.
PGX_CMS_DATABASE_URL=
PGX_CMS_IMPORT_ENV=staging
PGX_CMS_IMPORT_APPROVED=false
PGX_CMS_PRODUCTION_CONFIRMED=false
CLOUDFLARE_NCCI_API_URL=https://codical-ncci-api.<your-workers-subdomain>.workers.dev
CLOUDFLARE_MCD_API_URL=https://codical-mcd-api.<your-workers-subdomain>.workers.dev
VITE_SOCKET_IO_ENABLED=false

# Revenue Integrity clearinghouse connector. Keep live submission disabled
# until the BAA, provider/payer enrollments and certification suite are complete.
STEDI_API_KEY=
STEDI_MODE=test
STEDI_API_BASE_URL=https://healthcare.us.stedi.com
STEDI_WEBHOOK_SECRET=
REVENUE_INTEGRITY_TEST_SUBMISSION_ENABLED=false
REVENUE_INTEGRITY_LIVE_SUBMISSION_ENABLED=false
REVENUE_INTEGRITY_CRON_SECRET=
REVENUE_INTEGRITY_SESSION_SECRET=

# Optum sandbox validation connector. Sandbox claim submission remains disabled.
OPTUM_CLIENT_ID=
OPTUM_CLIENT_SECRET=
OPTUM_ENVIRONMENT=sandbox
OPTUM_AUTH_URL=https://sandbox-apigw.optum.com/apip/auth/v2/token
OPTUM_API_BASE_URL=https://sandbox-apigw.optum.com/medicalnetwork
OPTUM_CLAIM_VALIDATION_ENABLED=true
OPTUM_CLAIM_SUBMISSION_ENABLED=false

# Availity API Demo. Predefined/canned data only; never use PHI or live claims.
AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
AVAILITY_SCOPE=healthcare-hipaa-transactions-demo
AVAILITY_AUTH_URL=https://api.availity.com/v1/token
AVAILITY_API_BASE_URL=https://api.availity.com

# Claim.MD test-account connector. Account keys must remain server-side.
# Only fictional test-account data is allowed; production is hard-locked in code.
CLAIMMD_ACCOUNT_KEY=
CLAIMMD_MODE=test
CLAIMMD_API_BASE_URL=https://svc.claim.md
CLAIMMD_TEST_SUBMISSION_ENABLED=false
CLAIMMD_LIVE_SUBMISSION_ENABLED=false

# Production smoke test automation
PROD_BASE_URL=https://codical-healthcare.vercel.app
PROD_SMOKE_EMAIL=
PROD_SMOKE_PASSWORD=
PROD_SMOKE_REQUIRE_MCD=false
PROD_SMOKE_INCLUDE_AI=false
